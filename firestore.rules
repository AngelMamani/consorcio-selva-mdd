rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(userPath())
        && userDoc().active == true;
    }

    function assignedRoleCodes() {
      return userDoc().keys().hasAny(['roles']) && userDoc().roles is list
        ? userDoc().roles
        : [];
    }

    function hasRole(code) {
      return isActiveUser() && (
        userDoc().role == code
        || code in assignedRoleCodes()
      );
    }

    function isSuperAdmin() {
      return hasRole('SUPER_ADMINISTRADOR');
    }

    function isAdmin() {
      return hasRole('ADMINISTRADOR') || hasRole('SUPER_ADMINISTRADOR');
    }

    function folderPath(folderId) {
      return /databases/$(database)/documents/folders/$(folderId);
    }

    function folderData(folderId) {
      return get(folderPath(folderId)).data;
    }

    function canAccessFolderData(data) {
      return isAdmin()
        || data.ownerId == request.auth.uid
        || data.get('assignToAllTechnicians', false) == true
        || request.auth.uid in data.get('assignedTechnicianIds', []);
    }

    function canAccessFolder(folderId) {
      return isActiveUser()
        && exists(folderPath(folderId))
        && canAccessFolderData(folderData(folderId));
    }

    function canAccessTaskData(data) {
      return isAdmin()
        || data.createdById == request.auth.uid
        || data.get('assignToAllTechnicians', false) == true
        || request.auth.uid in data.get('assignedTechnicianIds', []);
    }

    function validTaskRoutes() {
      return request.resource.data.routes is list
        && request.resource.data.routes.size() > 0
        && request.resource.data.routes.size() <= 40;
    }

    function validLastNotice() {
      return !('lastNotice' in request.resource.data)
        || request.resource.data.lastNotice == null
        || (
          request.resource.data.lastNotice is map
          && request.resource.data.lastNotice.message is string
          && request.resource.data.lastNotice.message.size() > 0
          && request.resource.data.lastNotice.message.size() <= 280
          && request.resource.data.lastNotice.routeCode is string
          && request.resource.data.lastNotice.createdById is string
          && request.resource.data.lastNotice.createdByName is string
          && request.resource.data.lastNotice.createdByName.size() <= 120
          && request.resource.data.lastNotice.createdAt is timestamp
        );
    }

    // El técnico solo actualiza avance (completar ruta, GPS, aviso).
    // No pasa por validTaskWrite: esa regla rechazaba el completar.
    function validTechnicianTaskProgress() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
            'status', 'routes', 'lastNotice', 'updatedAt',
            'latitude', 'longitude',
            'completedAt', 'completedById', 'completedByName'
          ])
        && (
          request.resource.data.status == resource.data.status
          || request.resource.data.status in ['EN_PROGRESO', 'COMPLETADA']
        )
        && request.resource.data.routes is list
        && request.resource.data.routes.size() > 0
        && request.resource.data.routes.size() <= 40
        && (
          !changed.hasAny(['lastNotice'])
          || validLastNotice()
        );
    }

    function validTaskWrite() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status is string
        && request.resource.data.status in ['PENDIENTE', 'EN_PROGRESO', 'COMPLETADA']
        && request.resource.data.areaId is string
        && request.resource.data.areaId.size() <= 80
        && request.resource.data.areaName is string
        && request.resource.data.areaName.size() <= 120
        && request.resource.data.routeCode is string
        && (
          request.resource.data.routeCode.size() == 0
          || request.resource.data.routeCode.matches('^[0-9]{7,12}$')
        )
        && validTaskRoutes()
        && validLastNotice()
        && (
          !('latitude' in request.resource.data)
          || (
            request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
          )
        )
        && (
          !('longitude' in request.resource.data)
          || (
            request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180
          )
        )
        && (
          !('neighborhoodRouteName' in request.resource.data)
          || (
            request.resource.data.neighborhoodRouteName is string
            && (
              request.resource.data.neighborhoodRouteName.size() == 0
              || request.resource.data.neighborhoodRouteName.matches('^[0-9]{7,12}$')
            )
          )
        )
        && (
          !('neighborhoodLatitude' in request.resource.data)
          || (
            request.resource.data.neighborhoodLatitude is number
            && request.resource.data.neighborhoodLatitude >= -90
            && request.resource.data.neighborhoodLatitude <= 90
          )
        )
        && (
          !('neighborhoodLongitude' in request.resource.data)
          || (
            request.resource.data.neighborhoodLongitude is number
            && request.resource.data.neighborhoodLongitude >= -180
            && request.resource.data.neighborhoodLongitude <= 180
          )
        )
        && validAssignment(request.resource.data)
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.completedById is string
        && request.resource.data.completedByName is string
        && request.resource.data.completedByName.size() <= 120
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'status', 'dueDate',
          'areaId', 'areaName', 'routeCode', 'latitude', 'longitude',
          'routes', 'lastNotice',
          'neighborhoodRouteName', 'neighborhoodLatitude', 'neighborhoodLongitude',
          'assignToAllTechnicians', 'assignedTechnicianIds', 'assignedTechnicianNames',
          'createdById', 'createdByName',
          'completedAt', 'completedById', 'completedByName',
          'createdAt', 'updatedAt'
        ]);
    }

    function isOwnAttendanceId(attendanceId) {
      return attendanceId.size() == request.auth.uid.size() + 11
        && attendanceId[0:request.auth.uid.size()] == request.auth.uid
        && attendanceId[request.auth.uid.size():request.auth.uid.size() + 1] == '_'
        && attendanceId[request.auth.uid.size() + 1:attendanceId.size()]
          .matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validOfficeGpsCreate() {
      return request.resource.data.origin == 'OFICINA'
        && request.resource.data.officeValidated == true
        && request.resource.data.areaId is string
        && request.resource.data.areaName is string
        && !('officeQrToken' in request.resource.data);
    }

    function validZoneCreate() {
      return request.resource.data.origin == 'ZONA'
        && request.resource.data.officeValidated == false
        && request.resource.data.areaId is string
        && request.resource.data.areaName is string
        && !('officeQrToken' in request.resource.data);
    }

    function validPermisoCreate() {
      return request.resource.data.origin == 'PERMISO'
        && request.resource.data.officeValidated == false
        && request.resource.data.areaId is string
        && request.resource.data.areaName is string
        && !('officeQrToken' in request.resource.data)
        && !('environmentPhotoUrl' in request.resource.data)
        && !('environmentPhotoPath' in request.resource.data);
    }

    function optionalEnvironmentPhoto() {
      return (!('environmentPhotoUrl' in request.resource.data)
          && !('environmentPhotoPath' in request.resource.data))
        || (
          request.resource.data.environmentPhotoUrl is string
          && request.resource.data.environmentPhotoUrl.size() > 12
          && request.resource.data.environmentPhotoPath is string
          && request.resource.data.environmentPhotoPath.size() > 8
        );
    }

    function optionalPermissionNote() {
      return !('permissionNote' in request.resource.data)
        || (
          request.resource.data.permissionNote is string
          && request.resource.data.permissionNote.size() <= 200
        );
    }

    function optionalMarkedBy() {
      return (!('markedById' in request.resource.data)
          && !('markedByName' in request.resource.data))
        || (
          request.resource.data.markedById is string
          && request.resource.data.markedById.size() > 0
          && request.resource.data.markedById.size() <= 128
          && request.resource.data.markedByName is string
          && request.resource.data.markedByName.size() > 0
          && request.resource.data.markedByName.size() <= 120
        );
    }

    function unchangedKeys(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function validAssignment(data) {
      return data.assignToAllTechnicians is bool
        && data.assignedTechnicianIds is list
        && data.assignedTechnicianNames is list
        && data.assignedTechnicianIds.size() == data.assignedTechnicianNames.size()
        && (
          (data.assignToAllTechnicians == true
            && data.assignedTechnicianIds.size() == 0)
          || (data.assignToAllTechnicians == false
            && data.assignedTechnicianIds.size() > 0
            && data.assignedTechnicianIds.size() <= 50)
        );
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId)
        || (isActiveUser() && (
          resource.data.role == 'TECNICO'
          || (
            resource.data.keys().hasAny(['roles'])
            && resource.data.roles is list
            && 'TECNICO' in resource.data.roles
          )
        ));

      // Alta de usuarios solo vía Admin SDK / Cloud Functions.
      allow create: if false;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme', 'updatedAt'])
              && request.resource.data.theme in ['light', 'dark']
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
              && resource.data.mustChangePassword == true
              && request.resource.data.mustChangePassword == false
            )
          )
          && unchangedKeys(['email', 'role', 'roles', 'active', 'displayName', 'createdAt'])
        );

      allow delete: if false;
    }

    match /loginByDni/{dni} {
      allow get: if dni.matches('^[0-9]{8}$');
      allow list: if false;
      allow create, update: if isAdmin()
        && dni.matches('^[0-9]{8}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0;
      allow delete: if isAdmin();
    }

    match /supplies/{supplyId} {
      function validSupplyIdentity() {
        return supplyId == request.resource.data.routeCode
          && request.resource.data.routeCode is string
          && request.resource.data.routeCode.matches('^[0-9]{7,12}$')
          && request.resource.data.prefix is string
          && request.resource.data.prefix.matches('^[0-9]{4}$')
          && request.resource.data.updatedAt is timestamp
          && (
            !('note' in request.resource.data)
            || (
              request.resource.data.note is string
              && request.resource.data.note.size() <= 200
            )
          );
      }

      function supplyHasGps(data) {
        return data.latitude is number
          && data.latitude >= -90
          && data.latitude <= 90
          && data.longitude is number
          && data.longitude >= -180
          && data.longitude <= 180;
      }

      function supplyMissingGps(data) {
        return !('latitude' in data) && !('longitude' in data);
      }

      allow read: if isActiveUser();
      allow create: if isAdmin()
        && validSupplyIdentity()
        && (supplyHasGps(request.resource.data) || supplyMissingGps(request.resource.data));
      allow update: if validSupplyIdentity()
        && (
          (
            isAdmin()
            && (supplyHasGps(request.resource.data) || supplyMissingGps(request.resource.data))
          )
          || (
            isActiveUser()
            && supplyMissingGps(resource.data)
            && supplyHasGps(request.resource.data)
            && request.resource.data.routeCode == resource.data.routeCode
            && request.resource.data.prefix == resource.data.prefix
            && (
              !('note' in request.resource.data)
              || request.resource.data.note == resource.data.get('note', '')
            )
          )
        );
      allow delete: if isAdmin();
    }

    match /seds/{sedId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin()
        && sedId == request.resource.data.code
        && request.resource.data.code is string
        && request.resource.data.code.matches('^20[0-9]{5}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 180
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /areas/{areaId} {
      allow read: if isActiveUser();
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.createdByName is string
        && (!('assignmentMode' in request.resource.data)
          || request.resource.data.assignmentMode in ['routes', 'work_orders'])
        && (!('reportCode' in request.resource.data)
          || (request.resource.data.reportCode is string
            && request.resource.data.reportCode.size() <= 8));
      allow update: if isAdmin()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && (!('assignmentMode' in request.resource.data)
          || request.resource.data.assignmentMode in ['routes', 'work_orders'])
        && (!('reportCode' in request.resource.data)
          || (request.resource.data.reportCode is string
            && request.resource.data.reportCode.size() <= 8));
      allow delete: if isAdmin();
    }

    function validInstallationOrderWrite() {
      return request.resource.data.keys().hasOnly([
          'areaId', 'areaName', 'orderNumber', 'subType', 'applicantName',
          'applicantAddress', 'sectorCijp', 'sector', 'supplyCode',
          'neighborRouteCode', 'attentionCenter', 'executionNotes',
          'registeredFlag', 'categoryCode', 'referenceNumber', 'recordedAt',
          'typeInitials', 'classification', 'technicianId', 'technicianName',
          'scheduledDate', 'status', 'createdById', 'createdByName',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.areaId is string
        && request.resource.data.areaId.size() > 0
        && request.resource.data.areaId.size() <= 80
        && request.resource.data.areaName is string
        && request.resource.data.areaName.size() <= 120
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.matches('^[0-9]{8,20}$')
        && request.resource.data.subType is string
        && request.resource.data.subType.size() <= 80
        && request.resource.data.applicantName is string
        && request.resource.data.applicantName.size() <= 160
        && request.resource.data.applicantAddress is string
        && request.resource.data.applicantAddress.size() <= 220
        && request.resource.data.sectorCijp is string
        && request.resource.data.sectorCijp.size() <= 80
        && request.resource.data.sector is string
        && request.resource.data.sector.size() <= 80
        && request.resource.data.supplyCode is string
        && (request.resource.data.supplyCode == ''
          || request.resource.data.supplyCode.matches('^[0-9]{7,15}$'))
        && request.resource.data.neighborRouteCode is string
        && (request.resource.data.neighborRouteCode == ''
          || request.resource.data.neighborRouteCode.matches('^[0-9]{7,13}$'))
        && request.resource.data.attentionCenter is string
        && request.resource.data.attentionCenter.size() <= 80
        && request.resource.data.executionNotes is string
        && request.resource.data.executionNotes.size() <= 500
        && request.resource.data.registeredFlag is string
        && request.resource.data.registeredFlag.size() <= 8
        && request.resource.data.categoryCode is string
        && request.resource.data.categoryCode.size() <= 20
        && request.resource.data.referenceNumber is string
        && request.resource.data.referenceNumber.size() <= 20
        && (request.resource.data.recordedAt == null
          || request.resource.data.recordedAt is timestamp)
        && request.resource.data.typeInitials is string
        && request.resource.data.typeInitials.size() <= 8
        && request.resource.data.classification is string
        && request.resource.data.classification.size() <= 4
        && request.resource.data.technicianId is string
        && request.resource.data.technicianId.size() <= 80
        && request.resource.data.technicianName is string
        && request.resource.data.technicianName.size() <= 120
        && (
          (request.resource.data.technicianId == ''
            && request.resource.data.scheduledDate == null
            && request.resource.data.status == 'NO_REGISTRADO')
          || (request.resource.data.technicianId.size() > 0
            && request.resource.data.technicianName.size() > 0
            && request.resource.data.scheduledDate is timestamp
            && request.resource.data.status == 'PROGRAMADO')
        )
        && request.resource.data.createdById is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validMeterChangeOrderWrite() {
      return request.resource.data.keys().hasOnly([
          'areaId', 'areaName', 'orderNumber', 'pedido', 'customerName',
          'address', 'supplyCode', 'routeCode', 'meterSerial', 'typeCode',
          'systemType', 'changeDoneFlag', 'observations', 'latitude',
          'longitude', 'technicianId', 'technicianName', 'scheduledDate',
          'status', 'createdById', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.areaId is string
        && request.resource.data.areaId.size() > 0
        && request.resource.data.areaId.size() <= 80
        && request.resource.data.areaName is string
        && request.resource.data.areaName.size() <= 120
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.matches('^[0-9]{8,20}$')
        && request.resource.data.pedido is string
        && request.resource.data.pedido.size() <= 160
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 160
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 220
        && request.resource.data.supplyCode is string
        && (request.resource.data.supplyCode == ''
          || request.resource.data.supplyCode.matches('^[0-9]{7,15}$'))
        && request.resource.data.routeCode is string
        && (request.resource.data.routeCode == ''
          || request.resource.data.routeCode.matches('^[0-9]{7,15}$'))
        && request.resource.data.meterSerial is string
        && request.resource.data.meterSerial.size() <= 40
        && request.resource.data.typeCode is string
        && request.resource.data.typeCode.size() <= 8
        && request.resource.data.systemType is string
        && request.resource.data.systemType.size() <= 8
        && request.resource.data.changeDoneFlag is string
        && request.resource.data.changeDoneFlag.size() <= 12
        && request.resource.data.changeDoneFlag in ['PENDIENTE', 'PEN', 'SI', 'NO']
        && request.resource.data.observations is string
        && request.resource.data.observations.size() <= 500
        && (request.resource.data.latitude == null
          || request.resource.data.latitude is number)
        && (request.resource.data.longitude == null
          || request.resource.data.longitude is number)
        && request.resource.data.technicianId is string
        && request.resource.data.technicianId.size() <= 80
        && request.resource.data.technicianName is string
        && request.resource.data.technicianName.size() <= 120
        && (
          (request.resource.data.technicianId == ''
            && request.resource.data.scheduledDate == null
            && request.resource.data.status == 'NO_REGISTRADO')
          || (request.resource.data.technicianId.size() > 0
            && request.resource.data.technicianName.size() > 0
            && request.resource.data.scheduledDate is timestamp
            && request.resource.data.status == 'PROGRAMADO')
        )
        && request.resource.data.createdById is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /installationOrders/{orderId} {
      allow get: if isActiveUser()
        && (isAdmin() || resource.data.technicianId == request.auth.uid);
      allow list: if isActiveUser()
        && (isAdmin() || resource.data.technicianId == request.auth.uid);
      allow create: if isAdmin()
        && validInstallationOrderWrite()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isAdmin()
        && validInstallationOrderWrite()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt', 'areaId', 'orderNumber']);
      allow delete: if isAdmin();
    }

    match /meterChangeOrders/{orderId} {
      allow get: if isActiveUser()
        && (isAdmin() || resource.data.technicianId == request.auth.uid);
      allow list: if isActiveUser()
        && (isAdmin() || resource.data.technicianId == request.auth.uid);
      allow create: if isAdmin()
        && validMeterChangeOrderWrite()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isAdmin()
        && validMeterChangeOrderWrite()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt', 'areaId', 'orderNumber']);
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow get: if isActiveUser()
        && (resource == null || canAccessTaskData(resource.data));
      allow list: if isActiveUser() && canAccessTaskData(resource.data);
      allow create: if isAdmin()
        && validTaskWrite()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.completedById == ''
        && request.resource.data.completedByName == ''
        && request.resource.data.completedAt == null;
      allow update: if isActiveUser()
        && canAccessTaskData(resource.data)
        && unchangedKeys(['createdById', 'createdByName', 'createdAt'])
        && (
          validTechnicianTaskProgress()
          || (isAdmin() && validTaskWrite())
        );
      allow delete: if isAdmin();
    }

    function validCatalogWrite() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.nameKey is string
        && request.resource.data.nameKey.size() > 0
        && request.resource.data.nameKey.size() <= 80
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120;
    }

    match /cargos/{cargoId} {
      allow read: if isActiveUser();
      allow create: if isAdmin()
        && validCatalogWrite()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isAdmin()
        && validCatalogWrite()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /localidades/{localidadId} {
      allow read: if isActiveUser();
      allow create: if isAdmin()
        && validCatalogWrite()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isAdmin()
        && validCatalogWrite()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt']);
      allow delete: if isAdmin();
    }

    function validPersonalWrite() {
      return request.resource.data.nombres is string
        && request.resource.data.nombres.size() > 0
        && request.resource.data.nombres.size() <= 80
        && request.resource.data.apellidoPaterno is string
        && request.resource.data.apellidoPaterno.size() > 0
        && request.resource.data.apellidoPaterno.size() <= 60
        && request.resource.data.apellidoMaterno is string
        && request.resource.data.apellidoMaterno.size() <= 60
        && request.resource.data.dni is string
        && request.resource.data.dni.matches('^[0-9]{8}$')
        && request.resource.data.cargoId is string
        && request.resource.data.cargoId.size() > 0
        && request.resource.data.cargoName is string
        && request.resource.data.cargoName.size() > 0
        && request.resource.data.cargoName.size() <= 80
        && request.resource.data.localidadId is string
        && request.resource.data.localidadId.size() > 0
        && request.resource.data.localidadName is string
        && request.resource.data.localidadName.size() > 0
        && request.resource.data.localidadName.size() <= 80
        && request.resource.data.condicion is string
        && request.resource.data.condicion in ['', 'VIGENTE', 'RETIRADO', 'INGRESO']
        && request.resource.data.roleId is string
        && request.resource.data.roleName is string
        && (
          !('roleIds' in request.resource.data)
          || (
            request.resource.data.roleIds is list
            && request.resource.data.roleIds.size() <= 3
          )
        )
        && (
          !('roleNames' in request.resource.data)
          || request.resource.data.roleNames is list
        )
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() <= 120;
    }

    function validPersonalRolePatch() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['roleId', 'roleName', 'roleIds', 'roleNames', 'updatedAt'])
        && request.resource.data.roleId is string
        && request.resource.data.roleName is string
        && (
          !('roleIds' in request.resource.data)
          || (
            request.resource.data.roleIds is list
            && request.resource.data.roleIds.size() <= 3
          )
        )
        && (
          !('roleNames' in request.resource.data)
          || request.resource.data.roleNames is list
        )
        && request.resource.data.updatedAt is timestamp;
    }

    match /personal/{personId} {
      allow read: if isActiveUser();
      allow create: if isAdmin()
        && validPersonalWrite()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isAdmin()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt'])
        && (validPersonalWrite() || validPersonalRolePatch());
      allow delete: if isAdmin();
    }

    function validOperationalRoleWrite() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 40
        && request.resource.data.permissions is list
        && request.resource.data.permissions.size() > 0
        && request.resource.data.isSystem is bool
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120;
    }

    match /operationalRoles/{roleId} {
      allow read: if isActiveUser();
      allow create: if isSuperAdmin()
        && validOperationalRoleWrite()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isSuperAdmin()
        && validOperationalRoleWrite()
        && unchangedKeys(['code', 'isSystem', 'createdById', 'createdByName', 'createdAt']);
      allow delete: if isSuperAdmin();
    }

    match /folders/{folderId} {
      allow get: if isActiveUser()
        && (resource == null || canAccessFolderData(resource.data));

      allow list: if isActiveUser() && canAccessFolderData(resource.data);

      allow create: if isActiveUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.ownerName.size() <= 120
        && request.resource.data.areaId is string
        && request.resource.data.areaId.size() > 0
        && request.resource.data.areaName is string
        && request.resource.data.areaName.size() > 0
        && request.resource.data.areaName.size() <= 120
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.imageCount == 0
        && validAssignment(request.resource.data)
        && (!('latitude' in request.resource.data)
          || (request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90))
        && (!('longitude' in request.resource.data)
          || (request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180))
        && (!('locationAccuracy' in request.resource.data)
          || request.resource.data.locationAccuracy is number)
        && (!('locationCapturedAt' in request.resource.data)
          || request.resource.data.locationCapturedAt is timestamp)
        && (!('routeCode' in request.resource.data)
          || (request.resource.data.routeCode is string
            && request.resource.data.routeCode.matches('^[0-9]{7,12}$')))
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'ownerId', 'ownerName',
          'areaId', 'areaName',
          'assignToAllTechnicians', 'assignedTechnicianIds', 'assignedTechnicianNames',
          'imageCount', 'createdAt', 'updatedAt',
          'routeCode',
          'latitude', 'longitude', 'locationAccuracy', 'locationCapturedAt'
        ]);

      allow update: if isActiveUser()
        && canAccessFolderData(resource.data)
        && unchangedKeys(['ownerId', 'createdAt'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.imageCount is int
        && request.resource.data.imageCount >= 0
        && (
          !('routeCode' in resource.data)
          || request.resource.data.routeCode == resource.data.routeCode
        )
        && (
          !('assignToAllTechnicians' in request.resource.data)
          || validAssignment(request.resource.data)
        );

      allow delete: if isAdmin();
    }

    match /folderDates/{dateId} {
      // List/get no pueden usar get() a folders: Firestore rechaza la query/lectura.
      // El acceso a la carpeta se valida en los casos de uso.
      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && canAccessFolder(request.resource.data.folderId)
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.folderId is string
        && request.resource.data.folderId.size() > 0
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.imageCount == 0
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.keys().hasOnly([
          'folderId', 'dateKey', 'note', 'imageCount',
          'createdById', 'createdByName', 'createdAt', 'updatedAt'
        ]);

      allow update: if isActiveUser()
        && canAccessFolder(resource.data.folderId)
        && unchangedKeys(['folderId', 'dateKey', 'createdById', 'createdByName', 'createdAt'])
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.imageCount is int
        && request.resource.data.imageCount >= 0;

      allow delete: if isAdmin();
    }

    match /folderImages/{imageId} {
      allow list: if isActiveUser();
      allow get: if canAccessFolder(resource.data.folderId);

      allow create: if isActiveUser()
        && request.resource.data.uploadedById == request.auth.uid
        && request.resource.data.folderId is string
        && canAccessFolder(request.resource.data.folderId)
        && request.resource.data.dateId is string
        && request.resource.data.dateId.size() > 0
        && request.resource.data.storagePath is string
        && request.resource.data.downloadUrl is string
        && request.resource.data.contentType.matches('image/.*')
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes <= 10 * 1024 * 1024
        && (!('latitude' in request.resource.data)
          || (request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90))
        && (!('longitude' in request.resource.data)
          || (request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180))
        && (!('locationAccuracy' in request.resource.data)
          || request.resource.data.locationAccuracy is number)
        && (!('locationCapturedAt' in request.resource.data)
          || request.resource.data.locationCapturedAt is timestamp);

      allow delete: if isAdmin();

      allow update: if false;
    }

    match /documentationTypes/{typeId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.columns is list
        && request.resource.data.columns.size() <= 40;
      allow update: if isActiveUser()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.columns is list
        && request.resource.data.columns.size() <= 40;
      allow delete: if isActiveUser();
    }

    match /documentationRows/{rowId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.typeId is string
        && request.resource.data.typeId.size() > 0
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.values is map;
      allow update: if isActiveUser()
        && unchangedKeys(['typeId', 'createdById', 'createdByName', 'createdAt'])
        && request.resource.data.values is map;
      allow delete: if isActiveUser();
    }

    function validAttendanceSettings() {
      return request.resource.data.officeName is string
        && request.resource.data.officeName.size() > 0
        && request.resource.data.officeName.size() <= 120
        && request.resource.data.officeLatitude is number
        && request.resource.data.officeLatitude >= -90
        && request.resource.data.officeLatitude <= 90
        && request.resource.data.officeLongitude is number
        && request.resource.data.officeLongitude >= -180
        && request.resource.data.officeLongitude <= 180
        && request.resource.data.officeRadiusMeters is number
        && request.resource.data.officeRadiusMeters >= 10
        && request.resource.data.officeRadiusMeters <= 80;
    }

    function validSuppliesCatalog() {
      return request.resource.data.count is number
        && request.resource.data.count >= 0
        && request.resource.data.sedCount is number
        && request.resource.data.sedCount >= 0
        && request.resource.data.skipped is number
        && request.resource.data.skipped >= 0
        && request.resource.data.skippedSeds is number
        && request.resource.data.skippedSeds >= 0
        && request.resource.data.importedById == request.auth.uid
        && request.resource.data.importedByName is string
        && request.resource.data.importedByName.size() > 0
        && request.resource.data.importedByName.size() <= 120
        && request.resource.data.importedAt is timestamp;
    }

    function validMobileAppSettings() {
      return request.resource.data.versionName is string
        && request.resource.data.versionName.matches('^[0-9]+[.][0-9]+[.][0-9]+$')
        && request.resource.data.versionCode is int
        && request.resource.data.versionCode >= 1
        && request.resource.data.apkUrl is string
        && request.resource.data.apkUrl.size() > 12
        && request.resource.data.apkPath is string
        && request.resource.data.apkPath.size() > 8
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.forceUpdate is bool
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByName.size() > 0
        && request.resource.data.updatedByName.size() <= 120;
    }

    match /settings/{docId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && (
        (docId == 'attendance' && validAttendanceSettings())
        || (docId == 'mobileApp' && validMobileAppSettings())
        || (docId == 'suppliesCatalog' && validSuppliesCatalog())
      );
      allow delete: if false;
    }

    match /attendanceOfficeTokens/{dateKey} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.dateKey == dateKey
        && request.resource.data.token is string
        && request.resource.data.token.size() == 48
        && request.resource.data.validFrom is timestamp
        && request.resource.data.validUntil is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdById == request.auth.uid;
      allow delete: if false;
    }

    match /attendances/{attendanceId} {
      allow get: if isActiveUser() && (isAdmin() || isOwnAttendanceId(attendanceId));
      allow list: if isAdmin();

      allow create: if isActiveUser()
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 120
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && attendanceId == request.resource.data.userId + '_' + request.resource.data.dateKey
        && request.resource.data.origin in ['OFICINA', 'ZONA', 'PERMISO']
        && request.resource.data.areaId is string
        && request.resource.data.areaName is string
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.officeValidated is bool
        && (!('locationAccuracy' in request.resource.data)
          || request.resource.data.locationAccuracy is number)
        && (!('distanceToOfficeMeters' in request.resource.data)
          || request.resource.data.distanceToOfficeMeters is number)
        && optionalEnvironmentPhoto()
        && optionalPermissionNote()
        && optionalMarkedBy()
        && (
          (
            request.resource.data.userId == request.auth.uid
            && isOwnAttendanceId(attendanceId)
            && (validOfficeGpsCreate() || validZoneCreate() || validPermisoCreate())
          )
          || (
            isAdmin()
            && validPermisoCreate()
            && request.resource.data.markedById == request.auth.uid
          )
        );

      allow update, delete: if false;
    }

    match /technicianLocations/{userId} {
      allow get: if isActiveUser() && (isSuperAdmin() || request.auth.uid == userId);
      allow list: if isSuperAdmin();
      allow create, update: if isActiveUser()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.gpsActive is bool
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.gpsActive == false
          || (
            request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
            && request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180
          )
        )
        && (!('accuracyMeters' in request.resource.data)
          || request.resource.data.accuracyMeters == null
          || request.resource.data.accuracyMeters is number);
      allow delete: if false;

      match /routePoints/{pointId} {
        allow get, list: if isSuperAdmin();
        allow create: if isActiveUser()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.latitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180
          && request.resource.data.capturedAt is timestamp
          && (!('accuracyMeters' in request.resource.data)
            || request.resource.data.accuracyMeters == null
            || request.resource.data.accuracyMeters is number);
        allow update, delete: if false;
      }
    }

    match /supportTickets/{ticketId} {
      allow get: if isActiveUser() && (
        isAdmin() || resource.data.createdById == request.auth.uid
      );
      allow list: if isActiveUser() && (
        isAdmin() || resource.data.createdById == request.auth.uid
      );
      allow create: if isActiveUser()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.kind in ['SUGERENCIA', 'PROBLEMA']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 8
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'ABIERTO'
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data.createdById == resource.data.createdById
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.message == resource.data.message
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['ABIERTO', 'RESUELTO']
        && request.resource.data.response is string
        && request.resource.data.response.size() <= 1000;
      allow delete: if false;
    }
  }
}
