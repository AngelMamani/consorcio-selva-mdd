rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(userPath())
        && userDoc().active == true;
    }

    function isSuperAdmin() {
      return isActiveUser() && userDoc().role == 'SUPER_ADMINISTRADOR';
    }

    function isAdmin() {
      return isActiveUser() && (
        userDoc().role == 'ADMINISTRADOR'
        || userDoc().role == 'SUPER_ADMINISTRADOR'
      );
    }

    function folderPath(folderId) {
      return /databases/$(database)/documents/folders/$(folderId);
    }

    function folderData(folderId) {
      return get(folderPath(folderId)).data;
    }

    function canAccessFolderData(data) {
      return isAdmin()
        || data.ownerId == request.auth.uid
        || data.get('assignToAllTechnicians', false) == true
        || request.auth.uid in data.get('assignedTechnicianIds', []);
    }

    function canAccessFolder(folderId) {
      return isActiveUser()
        && exists(folderPath(folderId))
        && canAccessFolderData(folderData(folderId));
    }

    function canAccessTaskData(data) {
      return isAdmin()
        || data.createdById == request.auth.uid
        || data.get('assignToAllTechnicians', false) == true
        || request.auth.uid in data.get('assignedTechnicianIds', []);
    }

    function validTaskWrite() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status is string
        && request.resource.data.status in ['PENDIENTE', 'EN_PROGRESO', 'COMPLETADA']
        && request.resource.data.areaId is string
        && request.resource.data.areaId.size() <= 80
        && request.resource.data.areaName is string
        && request.resource.data.areaName.size() <= 120
        && request.resource.data.routeCode is string
        && (
          request.resource.data.routeCode.size() == 0
          || request.resource.data.routeCode.matches('^[0-9]{7,12}$')
        )
        && (
          !('latitude' in request.resource.data)
          || (
            request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
          )
        )
        && (
          !('longitude' in request.resource.data)
          || (
            request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180
          )
        )
        && validAssignment(request.resource.data)
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.completedById is string
        && request.resource.data.completedByName is string
        && request.resource.data.completedByName.size() <= 120
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'status', 'dueDate',
          'areaId', 'areaName', 'routeCode', 'latitude', 'longitude',
          'assignToAllTechnicians', 'assignedTechnicianIds', 'assignedTechnicianNames',
          'createdById', 'createdByName',
          'completedAt', 'completedById', 'completedByName',
          'createdAt', 'updatedAt'
        ]);
    }

    function isOwnAttendanceId(attendanceId) {
      return attendanceId.size() == request.auth.uid.size() + 11
        && attendanceId[0:request.auth.uid.size()] == request.auth.uid
        && attendanceId[request.auth.uid.size():request.auth.uid.size() + 1] == '_'
        && attendanceId[request.auth.uid.size() + 1:attendanceId.size()]
          .matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function officeTokenPath(dateKey) {
      return /databases/$(database)/documents/attendanceOfficeTokens/$(dateKey);
    }

    function validOfficeQrCreate() {
      let dateKey = request.resource.data.dateKey;
      let tokenSnap = get(officeTokenPath(dateKey)).data;
      return request.resource.data.origin == 'OFICINA'
        && request.resource.data.officeQrToken is string
        && request.resource.data.officeQrToken.size() == 48
        && exists(officeTokenPath(dateKey))
        && tokenSnap.token == request.resource.data.officeQrToken
        && request.time >= tokenSnap.validFrom
        && request.time < tokenSnap.validUntil;
    }

    function validZoneCreate() {
      return request.resource.data.origin == 'ZONA'
        && request.resource.data.areaId is string
        && request.resource.data.areaName is string
        && !('officeQrToken' in request.resource.data);
    }

    function optionalEnvironmentPhoto() {
      return (!('environmentPhotoUrl' in request.resource.data)
          && !('environmentPhotoPath' in request.resource.data))
        || (
          request.resource.data.environmentPhotoUrl is string
          && request.resource.data.environmentPhotoUrl.size() > 12
          && request.resource.data.environmentPhotoPath is string
          && request.resource.data.environmentPhotoPath.size() > 8
        );
    }

    function unchangedKeys(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function validAssignment(data) {
      return data.assignToAllTechnicians is bool
        && data.assignedTechnicianIds is list
        && data.assignedTechnicianNames is list
        && data.assignedTechnicianIds.size() == data.assignedTechnicianNames.size()
        && (
          (data.assignToAllTechnicians == true
            && data.assignedTechnicianIds.size() == 0)
          || (data.assignToAllTechnicians == false
            && data.assignedTechnicianIds.size() > 0
            && data.assignedTechnicianIds.size() <= 50)
        );
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId)
        || (isActiveUser() && resource.data.role == 'TECNICO');

      // Alta de usuarios solo vía Admin SDK / Cloud Functions.
      allow create: if false;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme', 'updatedAt'])
              && request.resource.data.theme in ['light', 'dark']
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
              && resource.data.mustChangePassword == true
              && request.resource.data.mustChangePassword == false
            )
          )
          && unchangedKeys(['email', 'role', 'active', 'displayName', 'createdAt'])
        );

      allow delete: if false;
    }

    match /loginByDni/{dni} {
      allow get: if dni.matches('^[0-9]{8}$');
      allow list: if false;
      allow create, update: if isAdmin()
        && dni.matches('^[0-9]{8}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0;
      allow delete: if isAdmin();
    }

    match /supplies/{supplyId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin()
        && supplyId == request.resource.data.routeCode
        && request.resource.data.routeCode is string
        && request.resource.data.routeCode.matches('^[0-9]{7,12}$')
        && request.resource.data.prefix is string
        && request.resource.data.prefix.matches('^[0-9]{4}$')
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /seds/{sedId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin()
        && sedId == request.resource.data.code
        && request.resource.data.code is string
        && request.resource.data.code.matches('^20[0-9]{5}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 180
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /areas/{areaId} {
      allow read: if isActiveUser();
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.createdByName is string;
      allow update: if isAdmin()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500;
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow get: if isActiveUser()
        && (resource == null || canAccessTaskData(resource.data));
      allow list: if isActiveUser() && canAccessTaskData(resource.data);
      allow create: if isAdmin()
        && validTaskWrite()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.completedById == ''
        && request.resource.data.completedByName == ''
        && request.resource.data.completedAt == null
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      allow update: if isActiveUser()
        && canAccessTaskData(resource.data)
        && unchangedKeys(['createdById', 'createdByName', 'createdAt'])
        && validTaskWrite()
        && (
          isAdmin()
          || (
            request.resource.data.title == resource.data.title
            && request.resource.data.description == resource.data.description
            && request.resource.data.dueDate == resource.data.dueDate
            && request.resource.data.areaId == resource.data.areaId
            && request.resource.data.areaName == resource.data.areaName
            && request.resource.data.routeCode == resource.data.routeCode
            && (
              !('latitude' in resource.data)
              || request.resource.data.latitude == resource.data.latitude
            )
            && (
              !('longitude' in resource.data)
              || request.resource.data.longitude == resource.data.longitude
            )
            && request.resource.data.assignToAllTechnicians
              == resource.data.assignToAllTechnicians
            && request.resource.data.assignedTechnicianIds
              == resource.data.assignedTechnicianIds
            && request.resource.data.assignedTechnicianNames
              == resource.data.assignedTechnicianNames
            && request.resource.data.status in ['EN_PROGRESO', 'COMPLETADA']
          )
        );
      allow delete: if isAdmin();
    }

    function validCatalogWrite() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.nameKey is string
        && request.resource.data.nameKey.size() > 0
        && request.resource.data.nameKey.size() <= 80
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120;
    }

    match /cargos/{cargoId} {
      allow read: if isActiveUser();
      allow create: if isAdmin()
        && validCatalogWrite()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isAdmin()
        && validCatalogWrite()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /localidades/{localidadId} {
      allow read: if isActiveUser();
      allow create: if isAdmin()
        && validCatalogWrite()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isAdmin()
        && validCatalogWrite()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt']);
      allow delete: if isAdmin();
    }

    function validPersonalWrite() {
      return request.resource.data.nombres is string
        && request.resource.data.nombres.size() > 0
        && request.resource.data.nombres.size() <= 80
        && request.resource.data.apellidoPaterno is string
        && request.resource.data.apellidoPaterno.size() > 0
        && request.resource.data.apellidoPaterno.size() <= 60
        && request.resource.data.apellidoMaterno is string
        && request.resource.data.apellidoMaterno.size() > 0
        && request.resource.data.apellidoMaterno.size() <= 60
        && request.resource.data.dni is string
        && request.resource.data.dni.matches('^[0-9]{8}$')
        && request.resource.data.cargoId is string
        && request.resource.data.cargoId.size() > 0
        && request.resource.data.cargoName is string
        && request.resource.data.cargoName.size() > 0
        && request.resource.data.cargoName.size() <= 80
        && request.resource.data.localidadId is string
        && request.resource.data.localidadId.size() > 0
        && request.resource.data.localidadName is string
        && request.resource.data.localidadName.size() > 0
        && request.resource.data.localidadName.size() <= 80
        && request.resource.data.condicion is string
        && request.resource.data.condicion in ['', 'VIGENTE', 'RETIRADO', 'INGRESO']
        && request.resource.data.roleId is string
        && request.resource.data.roleName is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120;
    }

    match /personal/{personId} {
      allow read: if isActiveUser();
      allow create: if isAdmin()
        && validPersonalWrite()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isAdmin()
        && validPersonalWrite()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt']);
      allow delete: if isAdmin();
    }

    function validOperationalRoleWrite() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 40
        && request.resource.data.permissions is list
        && request.resource.data.permissions.size() > 0
        && request.resource.data.isSystem is bool
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120;
    }

    match /operationalRoles/{roleId} {
      allow read: if isActiveUser();
      allow create: if isSuperAdmin()
        && validOperationalRoleWrite()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isSuperAdmin()
        && validOperationalRoleWrite()
        && unchangedKeys(['code', 'isSystem', 'createdById', 'createdByName', 'createdAt']);
      allow delete: if isSuperAdmin();
    }

    match /folders/{folderId} {
      allow get: if isActiveUser()
        && (resource == null || canAccessFolderData(resource.data));

      allow list: if isActiveUser() && canAccessFolderData(resource.data);

      allow create: if isActiveUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.ownerName.size() <= 120
        && request.resource.data.areaId is string
        && request.resource.data.areaId.size() > 0
        && request.resource.data.areaName is string
        && request.resource.data.areaName.size() > 0
        && request.resource.data.areaName.size() <= 120
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.imageCount == 0
        && validAssignment(request.resource.data)
        && (!('latitude' in request.resource.data)
          || (request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90))
        && (!('longitude' in request.resource.data)
          || (request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180))
        && (!('locationAccuracy' in request.resource.data)
          || request.resource.data.locationAccuracy is number)
        && (!('locationCapturedAt' in request.resource.data)
          || request.resource.data.locationCapturedAt is timestamp)
        && (!('routeCode' in request.resource.data)
          || (request.resource.data.routeCode is string
            && request.resource.data.routeCode.matches('^[0-9]{7,12}$')))
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'ownerId', 'ownerName',
          'areaId', 'areaName',
          'assignToAllTechnicians', 'assignedTechnicianIds', 'assignedTechnicianNames',
          'imageCount', 'createdAt', 'updatedAt',
          'routeCode',
          'latitude', 'longitude', 'locationAccuracy', 'locationCapturedAt'
        ]);

      allow update: if isActiveUser()
        && canAccessFolderData(resource.data)
        && unchangedKeys(['ownerId', 'createdAt'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.imageCount is int
        && request.resource.data.imageCount >= 0
        && (
          !('routeCode' in resource.data)
          || request.resource.data.routeCode == resource.data.routeCode
        )
        && (
          !('assignToAllTechnicians' in request.resource.data)
          || validAssignment(request.resource.data)
        );

      allow delete: if isAdmin();
    }

    match /folderDates/{dateId} {
      // List/get no pueden usar get() a folders: Firestore rechaza la query/lectura.
      // El acceso a la carpeta se valida en los casos de uso.
      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && canAccessFolder(request.resource.data.folderId)
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.folderId is string
        && request.resource.data.folderId.size() > 0
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.imageCount == 0
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.keys().hasOnly([
          'folderId', 'dateKey', 'note', 'imageCount',
          'createdById', 'createdByName', 'createdAt', 'updatedAt'
        ]);

      allow update: if isActiveUser()
        && canAccessFolder(resource.data.folderId)
        && unchangedKeys(['folderId', 'dateKey', 'createdById', 'createdByName', 'createdAt'])
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.imageCount is int
        && request.resource.data.imageCount >= 0;

      allow delete: if isAdmin();
    }

    match /folderImages/{imageId} {
      allow list: if isActiveUser();
      allow get: if canAccessFolder(resource.data.folderId);

      allow create: if isActiveUser()
        && request.resource.data.uploadedById == request.auth.uid
        && request.resource.data.folderId is string
        && canAccessFolder(request.resource.data.folderId)
        && request.resource.data.dateId is string
        && request.resource.data.dateId.size() > 0
        && request.resource.data.storagePath is string
        && request.resource.data.downloadUrl is string
        && request.resource.data.contentType.matches('image/.*')
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes <= 10 * 1024 * 1024
        && (!('latitude' in request.resource.data)
          || (request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90))
        && (!('longitude' in request.resource.data)
          || (request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180))
        && (!('locationAccuracy' in request.resource.data)
          || request.resource.data.locationAccuracy is number)
        && (!('locationCapturedAt' in request.resource.data)
          || request.resource.data.locationCapturedAt is timestamp);

      allow delete: if isAdmin();

      allow update: if false;
    }

    match /documentationTypes/{typeId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.columns is list
        && request.resource.data.columns.size() <= 40;
      allow update: if isActiveUser()
        && unchangedKeys(['createdById', 'createdByName', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.columns is list
        && request.resource.data.columns.size() <= 40;
      allow delete: if isActiveUser();
    }

    match /documentationRows/{rowId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.typeId is string
        && request.resource.data.typeId.size() > 0
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.values is map;
      allow update: if isActiveUser()
        && unchangedKeys(['typeId', 'createdById', 'createdByName', 'createdAt'])
        && request.resource.data.values is map;
      allow delete: if isActiveUser();
    }

    function validAttendanceSettings() {
      return request.resource.data.officeName is string
        && request.resource.data.officeName.size() > 0
        && request.resource.data.officeName.size() <= 120
        && request.resource.data.officeLatitude is number
        && request.resource.data.officeLatitude >= -90
        && request.resource.data.officeLatitude <= 90
        && request.resource.data.officeLongitude is number
        && request.resource.data.officeLongitude >= -180
        && request.resource.data.officeLongitude <= 180
        && request.resource.data.officeRadiusMeters is number
        && request.resource.data.officeRadiusMeters >= 5
        && request.resource.data.officeRadiusMeters <= 20;
    }

    function validSuppliesCatalog() {
      return request.resource.data.count is number
        && request.resource.data.count >= 0
        && request.resource.data.sedCount is number
        && request.resource.data.sedCount >= 0
        && request.resource.data.skipped is number
        && request.resource.data.skipped >= 0
        && request.resource.data.skippedSeds is number
        && request.resource.data.skippedSeds >= 0
        && request.resource.data.importedById == request.auth.uid
        && request.resource.data.importedByName is string
        && request.resource.data.importedByName.size() > 0
        && request.resource.data.importedByName.size() <= 120
        && request.resource.data.importedAt is timestamp;
    }

    function validMobileAppSettings() {
      return request.resource.data.versionName is string
        && request.resource.data.versionName.matches('^[0-9]+[.][0-9]+[.][0-9]+$')
        && request.resource.data.versionCode is int
        && request.resource.data.versionCode >= 1
        && request.resource.data.apkUrl is string
        && request.resource.data.apkUrl.size() > 12
        && request.resource.data.apkPath is string
        && request.resource.data.apkPath.size() > 8
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.forceUpdate is bool
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByName.size() > 0
        && request.resource.data.updatedByName.size() <= 120;
    }

    match /settings/{docId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && (
        (docId == 'attendance' && validAttendanceSettings())
        || (docId == 'mobileApp' && validMobileAppSettings())
        || (docId == 'suppliesCatalog' && validSuppliesCatalog())
      );
      allow delete: if false;
    }

    match /attendanceOfficeTokens/{dateKey} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.dateKey == dateKey
        && request.resource.data.token is string
        && request.resource.data.token.size() == 48
        && request.resource.data.validFrom is timestamp
        && request.resource.data.validUntil is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdById == request.auth.uid;
      allow delete: if false;
    }

    match /attendances/{attendanceId} {
      allow get: if isActiveUser() && (isAdmin() || isOwnAttendanceId(attendanceId));
      allow list: if isAdmin();

      allow create: if isActiveUser()
        && userDoc().role == 'TECNICO'
        && isOwnAttendanceId(attendanceId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 120
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && attendanceId == request.auth.uid + '_' + request.resource.data.dateKey
        && request.resource.data.origin in ['OFICINA', 'ZONA']
        && request.resource.data.areaId is string
        && request.resource.data.areaName is string
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.officeValidated is bool
        && (!('locationAccuracy' in request.resource.data)
          || request.resource.data.locationAccuracy is number)
        && (!('distanceToOfficeMeters' in request.resource.data)
          || request.resource.data.distanceToOfficeMeters is number)
        && optionalEnvironmentPhoto()
        && (validOfficeQrCreate() || validZoneCreate());

      allow update, delete: if false;
    }
  }
}
